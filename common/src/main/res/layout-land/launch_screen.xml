<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start launch screen (landscape): phone left, dashed link, head unit right.
     Margins mirror drawable-land/launch_window_background.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF090F1B">
    <ImageView
        android:id="@+id/launch_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginRight="362dp"
        android:src="@drawable/launch_phone" />
    <ImageView
        android:id="@+id/launch_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginRight="120dp"
        android:src="@drawable/launch_link_horizontal" />
    <ImageView
        android:id="@+id/launch_head_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="242dp"
        android:src="@drawable/launch_head_unit" />
</FrameLayout>
