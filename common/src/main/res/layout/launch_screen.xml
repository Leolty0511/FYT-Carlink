<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start launch screen (portrait): phone above, dashed link, head unit below.
     Margins mirror drawable/launch_window_background.xml so the Activity overlay lines up
     pixel-for-pixel with the system starting window, then animates away into the page. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF090F1B">
    <ImageView
        android:id="@+id/launch_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="272dp"
        android:src="@drawable/launch_phone" />
    <ImageView
        android:id="@+id/launch_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:src="@drawable/launch_link_vertical" />
    <ImageView
        android:id="@+id/launch_head_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="322dp"
        android:src="@drawable/launch_head_unit" />
</FrameLayout>
