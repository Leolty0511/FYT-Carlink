<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, user-authorized startup of the car's own hotspot. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: diagnostic reports in the visible Downloads/T-link folder on Android 9.
         Android 10+ needs no permission for this, so it is never requested there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Optional: the dashboard map as a card over the home screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional, owner-enabled Usage Access for the verified DiLink 5.1 cluster profile. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- The centre card also follows whichever launcher is the default home. -->
    <queries>
        <package android:name="com.byd.carsettings" />
        <!-- FYT phone Bluetooth UI and its read-only module status service. -->
        <package android:name="com.syu.bt" />
        <package android:name="com.syu.ms" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
    <application>
        <provider
            android:name="com.shilapi.xcertplay.DiagnosticReportProvider"
            android:authorities="${applicationId}.diagnostic-reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_report_paths" />
        </provider>
        <activity android:name="com.shilapi.xcertplay.DiPlayActivity"
            android:exported="true" android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Xcertplay.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
        <service android:name="com.shilapi.xcertplay.DiPlaySessionService"
            android:exported="false" android:foregroundServiceType="connectedDevice|microphone|location" />

        <!-- Owns the vendor CarplayServer Binder and video socket independently of UI lifetime. -->
        <service
            android:name="com.shilapi.xcertplay.VendorCarplaySessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:taskAffinity="${applicationId}.carplay"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/mfi_usb_device_filter" />
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.AdbClusterActivity"
            android:label="@string/adb_cluster_activity_label"
            android:icon="@drawable/ic_dp_navigation"
            android:taskAffinity="${applicationId}.cluster"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:allowEmbedded="true"
            android:exported="true"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.AdbCluster">
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.CarPlayVideoActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Xcertplay" />

        <!-- Full-screen host for the head unit's vendor CarPlay engine (CarplayServer binder).
             exported=true so system services (uid 2000) can start it; same-process callers bypass this. -->
        <activity
            android:name="com.shilapi.xcertplay.VendorCarplayActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VendorCarplay" />

        <activity
            android:name="com.shilapi.xcertplay.MainActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <!-- CarPlay navigation widget, for launchers that host standard widgets. -->
        <receiver
            android:name="com.shilapi.xcertplay.NavigationWidget"
            android:exported="false"
            android:label="@string/navigation_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navigation_widget_info" />
        </receiver>

        <!-- The live dashboard map for launchers that embed it. -->
        <service
            android:name="com.shilapi.xcertplay.MapEmbedService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="FYT.Tlink.action.EMBED_MAP" />
            </intent-filter>
        </service>

        <!-- Optional: steering-wheel keys for the dashboard map zoom. -->
        <service
            android:name="com.shilapi.xcertplay.WheelKeyService"
            android:exported="true"
            android:label="@string/wheel_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wheel_key_service" />
        </service>

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.shilapi.xcertplay.UsbAutoConfirmService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_auto_confirm_service_config" />
        </service>
    </application>

</manifest>
