<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Light">
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ActTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/bitmap_bk</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="ActivityStart" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/bitmap_bk</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="Dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@color/white2</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Trans" parent="">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Theme.Toast" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:drawable/toast_frame</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Toast</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="DialogText" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#ff000000</item>
    </style>
    <style name="DialogText.Title" parent="@style/DialogText">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">0x1</item>
    </style>
    <style name="strReset" parent="">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="strPopNumber" parent="">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="txt_style_none" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">#ff000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    <style name="txt_style_white" parent="">
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">@color/black</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
    <style name="txt_style_black" parent="">
        <item name="android:textColor">@color/black</item>
        <item name="android:shadowColor">@color/white</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
</resources>
