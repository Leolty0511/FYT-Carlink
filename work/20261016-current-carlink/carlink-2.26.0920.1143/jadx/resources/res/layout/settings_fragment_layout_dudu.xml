<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:background="#ff1a1a1a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/virtual_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout5"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/exit_ic_dd"/>
        <TextView
            android:textSize="@dimen/settings_title_text_size"
            android:textColor="@android:color/white"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            app:layout_constraintBottom_toBottomOf="@+id/back_iv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/back_iv"/>
        <View
            android:id="@+id/view2"
            android:background="#00628ac2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/back_iv"/>
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view2">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout"
                    android:background="@drawable/settings_item_ic_dd"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    android:layout_marginStart="@dimen/settings_item_start"
                    android:layout_marginEnd="@dimen/settings_item_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/noise_title_msg"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/noise_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkedButton="@+id/noise_null"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/noise_null"
                            android:background="@drawable/check_button_ic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/not_needed"
                            android:layout_weight="1"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/noise_left"
                            android:background="@drawable/check_button_ic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/left_channel"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/noise_right"
                            android:background="@drawable/check_button_ic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/right_channel"
                            style="@style/CustomRadioBtn"/>
                    </RadioGroup>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/band_layout"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    android:layout_marginStart="@dimen/settings_item_start"
                    android:layout_marginEnd="@dimen/settings_item_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraintLayout">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/ap_band_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/apband_2_4g"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2.4G"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/apband_5g"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="5G"
                            style="@style/CustomRadioBtn"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_network"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fps_layout"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    android:layout_marginStart="@dimen/settings_item_start"
                    android:layout_marginEnd="@dimen/settings_item_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/band_layout">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/fps_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fps_settings_text"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/fps_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkedButton="@+id/fps_low"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/fps_low"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/fps_low_text"
                            android:layout_weight="1"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/fps_medium"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/fps_medium_text"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:textColor="@color/activate_textcolor_zlink_dd"
                            android:id="@+id/fps_high"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="@string/fps_high_text"
                            style="@style/CustomRadioBtn"/>
                    </RadioGroup>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/resolution_layout"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    android:layout_marginStart="@dimen/settings_item_start"
                    android:layout_marginEnd="@dimen/settings_item_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/fps_layout">
                    <RadioGroup
                        android:orientation="horizontal"
                        android:id="@+id/resolution_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:id="@+id/resolution_hd"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="HD"
                            style="@style/CustomRadioBtn"/>
                        <View
                            android:layout_width="6dp"
                            android:layout_height="1dp"/>
                        <RadioButton
                            android:textSize="@dimen/check_button_textsize"
                            android:id="@+id/resolution_fhd"
                            android:background="@drawable/check_button_ic_dd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="FHD"
                            style="@style/CustomRadioBtn"/>
                    </RadioGroup>
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="#f1ebeb"
                        android:id="@+id/resolution_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resolution"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/active_layout"
                    android:background="@drawable/settings_item_ic_dd"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    app:layout_constraintEnd_toEndOf="@+id/band_layout"
                    app:layout_constraintStart_toStartOf="@+id/band_layout"
                    app:layout_constraintTop_toBottomOf="@+id/resolution_layout">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="#fff0eaea"
                        android:id="@+id/wireless_active_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_wireless_carplay"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@color/activate_textcolor_zlink"
                        android:gravity="center"
                        android:id="@+id/mode_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="已激活"
                        android:paddingEnd="6dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout6"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    android:layout_marginStart="@dimen/settings_item_start"
                    android:layout_marginEnd="@dimen/settings_item_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/active_layout">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_msg"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/version_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0"
                        android:paddingEnd="6dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/car_mark_settings"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    app:layout_constraintEnd_toEndOf="@+id/constraintLayout6"
                    app:layout_constraintStart_toStartOf="@+id/constraintLayout6"
                    app:layout_constraintTop_toBottomOf="@+id/constraintLayout6">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/car_mark_title"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:textSize="24px"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/car_logo_iv"
                        android:layout_width="@dimen/car_logo_size"
                        android:layout_height="@dimen/car_logo_size"
                        android:scaleType="fitXY"
                        android:text="1.0"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView8"
                        app:srcCompat="@drawable/icon_carlink"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/auto_link"
                    android:background="@drawable/settings_item_ic_dd"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/settings_item_height"
                    app:layout_constraintEnd_toEndOf="@+id/constraintLayout6"
                    app:layout_constraintStart_toStartOf="@+id/constraintLayout6"
                    app:layout_constraintTop_toBottomOf="@+id/car_mark_settings">
                    <TextView
                        android:textSize="@dimen/settings_text_size"
                        android:textColor="@android:color/white"
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_connect_text"
                        android:layout_marginStart="@dimen/settings_item_text_start"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <Switch
                        android:id="@+id/auto_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleX="@dimen/check_box_scale"
                        android:scaleY="@dimen/check_box_scale"
                        android:layout_marginEnd="@dimen/check_box_right_space"
                        android:thumbTint="#ff688cc0"
                        android:trackTint="#ff688cc0"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
