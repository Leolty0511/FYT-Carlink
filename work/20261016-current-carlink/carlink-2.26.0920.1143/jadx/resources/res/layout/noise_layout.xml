<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RadioGroup
        android:id="@+id/radio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noise_title">
        <RadioButton
            android:id="@+id/no_noise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_needed"/>
        <RadioButton
            android:id="@+id/left_noise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/left_channel"/>
        <RadioButton
            android:id="@+id/right_noise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/right_channel"/>
    </RadioGroup>
    <TextView
        android:textSize="16sp"
        android:id="@+id/noise_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/noise_title_msg"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
