<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true">
        <shape>
            <size
                android:height="@dimen/check_button_height"
                android:width="@dimen/check_button_width"/>
            <solid android:color="#ff688cc0"/>
            <corners android:radius="@dimen/check_button_radius"/>
            <stroke
                android:width="2dp"
                android:color="#ff628ac2"/>
            <padding
                android:left="4dp"
                android:right="4dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <size
                android:height="@dimen/check_button_height"
                android:width="@dimen/check_button_width"/>
            <solid android:color="#ff1a1d20"/>
            <corners android:radius="@dimen/check_button_radius"/>
            <stroke
                android:width="2dp"
                android:color="#ff628ac2"/>
            <padding
                android:left="4dp"
                android:right="4dp"/>
        </shape>
    </item>
</selector>
