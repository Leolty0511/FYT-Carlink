<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-4dp">
        <shape>
            <solid android:color="#ff1a1d20"/>
            <stroke
                android:width="1px"
                android:color="#ff2a2d30"/>
            <padding android:left="6dp"/>
        </shape>
    </item>
    <item
        android:state_pressed="true"
        android:top="-4dp">
        <shape>
            <solid android:color="#ff252830"/>
            <stroke
                android:width="1px"
                android:color="#ff2a2d30"/>
            <padding android:left="6dp"/>
        </shape>
    </item>
</selector>
