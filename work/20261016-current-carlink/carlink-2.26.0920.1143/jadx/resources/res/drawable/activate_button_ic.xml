<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#99f46d42"/>
            <corners android:radius="8dp"/>
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp"/>
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <solid android:color="#f46d42"/>
            <corners android:radius="8dp"/>
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#4df46d42"/>
            <corners android:radius="8dp"/>
            <padding
                android:left="8dp"
                android:top="6dp"
                android:right="8dp"
                android:bottom="6dp"/>
        </shape>
    </item>
</selector>
